{
  "name": "block-sim",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run prepare-assets && vite",
    "build": "npm run prepare-assets && tsc --noEmit && vite build",
    "build:beta": "VITE_CHANNEL=beta npm run prepare-assets && tsc --noEmit && VITE_CHANNEL=beta vite build",
    "preview": "vite preview",
    "lint": "eslint src tests scripts --max-warnings 0",
    "test": "vitest run",
    "fixtures": "node scripts/make-fixtures.mjs",
    "e2e": "playwright test",
    "private-test": "playwright test --config playwright.private.config.ts",
    "build:all": "npm run build:beta && npm run build && rm -rf dist/beta && cp -R dist-beta dist/beta"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "dexie": "^4.4.7",
    "fflate": "^0.8.3",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.1.1",
    "@playwright/test": "^1.65.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
